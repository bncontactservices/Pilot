# Secrets des Edge Functions — à poser avec `npx supabase secrets set --env-file supabase/functions/.env`
# (copier ce fichier en supabase/functions/.env, jamais commité).
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase.

# URL publique de l'application, utilisée dans les liens d'invitation et les redirections de paiement.
# C'est aussi la seule origine admise par les fonctions appelées depuis le navigateur (CORS) : en production, l'adresse du site.
APP_URL=http://localhost:5173
# Origines supplémentaires admises par CORS, séparées par des virgules (poste de développement, site de prévisualisation).
# Facultatif ; sans APP_URL ni cette liste, le navigateur refuse tout appel aux fonctions.
ALLOWED_ORIGINS=

# Envoi d'e-mails (facultatif). Sans clé, les invitations restent partageables par lien.
RESEND_API_KEY=
EMAIL_FROM="Pilot M&E <invitations@votre-domaine.example>"

# Lot 1 (submit-lead) : destinataire des demandes de la landing (avec RESEND_API_KEY et EMAIL_FROM
# ci-dessus). Sans ces trois valeurs, les demandes sont seulement enregistrées dans la table `leads`.
CONTACT_EMAIL=
# Facultatif : active la vérification Turnstile côté serveur (poser la clé de site côté front).
TURNSTILE_SECRET_KEY=
# Facultatif : clé de l'empreinte des adresses IP. À défaut, la clé service est utilisée.
IP_HASH_SALT=
