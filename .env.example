# Variables publiques du front (préfixe VITE_). Copier en .env.local, jamais commité.
# Aucune clé secrète ici : la clé service Supabase n'existe jamais côté front.

# Projet Supabase (Settings > API) : URL et clé anon (ou « publishable »).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contact commercial (dialogue de changement de plan, fin d'essai, landing).
VITE_CONTACT_EMAIL=
# Numéro WhatsApp au format international, chiffres seulement (ex. 221770000000).
VITE_WHATSAPP_NUMBER=

# Lot 1 : landing, analytics et référencement.
# Nom de l'éditeur (fondateur ou société), affiché dans le pied de page et les mentions légales.
VITE_EDITEUR_NOM=
# Adresse publique du site, sans barre finale (https://exemple.com) : sitemap.xml et balises Open Graph.
# Sans elle, le sitemap n'est pas généré (il exige des adresses absolues).
VITE_SITE_URL=
# Lien d'une démonstration en ligne (facultatif).
VITE_DEMO_URL=
# Domaine déclaré chez Plausible (statistiques sans cookie). Sans lui, aucun script de mesure n'est chargé.
VITE_PLAUSIBLE_DOMAIN=
# Clé de site Cloudflare Turnstile (facultatif). Poser aussi TURNSTILE_SECRET_KEY côté fonction.
VITE_TURNSTILE_SITE_KEY=
